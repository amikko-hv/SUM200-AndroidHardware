<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app requires a camera and will only work on devices with one -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <!-- Need permission to use the camera -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Need permission to read the phone GPS position -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SUM200AndroidHardware">
        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:label="@string/title_activity_camera"
            android:theme="@style/Theme.SUM200AndroidHardware" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SUM200AndroidHardware">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ShakeActivity"
            android:exported="false"
            android:label="@string/title_activity_shake"
            android:theme="@style/Theme.SUM200AndroidHardware"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".GpsActivity"
            android:exported="false"
            android:label="@string/title_activity_gps"
            android:theme="@style/Theme.SUM200AndroidHardware"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>